# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — keep your token out of git.

# Your Canvas instance base URL, e.g. https://canvas.university.edu
CANVAS_BASE_URL=

# Canvas personal access token: Canvas > Account > Settings > New Access Token
CANVAS_API_TOKEN=

# Postgres example: postgresql+psycopg://USER:PASS@HOST/synapse?sslmode=require
DATABASE_URL=sqlite:///./app.db

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=